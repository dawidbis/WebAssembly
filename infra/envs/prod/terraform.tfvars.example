# Skopiuj do terraform.tfvars (plik jest poza repo). Wszystkie pola są opcjonalne.

# Własna domena – bez niej gra działa pod adresem https://<id>.cloudfront.net.
# domain_name = "example.com"
# create_zone = false   # true, gdy domena jest u innego rejestratora (potem wpisz NS z `terraform output name_servers`)

# profile = "wieczko"
# region  = "eu-central-1"
